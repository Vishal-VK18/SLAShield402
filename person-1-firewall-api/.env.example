# ==============================================================================
# SLAShield402 - Person 1: Firewall API & x402 Gateway Configuration
# ==============================================================================

# Local HTTP port where the Hono firewall server listens (Default: 3000)
PORT=3000

# Algorand Testnet Indexer API endpoint (used to verify transaction hashes on-chain)
INDEXER_SERVER=https://testnet-idx.algonode.cloud

# x402 Facilitator service URL (used in standard WWW-Authenticate challenge header)
FACILITATOR_URL=https://facilitator.goplausible.xyz

# SLAShield402 fee recipient wallet address (generate using: algokit generate account)
SLASHIELD_RECIPIENT_ADDRESS=YVEHNV3EWF4GULZHABH64QKOYLE5MO2MSBAAK7O76A2ESACA5OV2AZSOKQ

# x402 firewall intercept evaluation fee in micro-USDC (1000 micro-units = 0.001 USDC)
SHIELD_CHECK_FEE_MICRO_USDC=1000

# Official Circle Testnet USDC Asset ID on Algorand Testnet (ASA ID: 10458941, 6 decimals)
USDC_ASA_ID=10458941

# Live Deployed SLAShield402 Escrow Smart Contract Application ID on Algorand Testnet
SLASHIELD_ESCROW_APP_ID=769236555
